# ROOT public website environment
# Do not place PHI, patient identifiers, payer files, API secrets, or production credentials here.

VITE_ROOT_PUBLIC_DOMAIN=https://rootrcm.com
VITE_ROOT_CONTACT_EMAIL=info@rootrcm.com
VITE_ROOT_PLATFORM_SCOPE=PHI-capable healthcare MSO platform

# Optional override for the public commercial inquiry relay.
# When blank, the public site uses the FormSubmit AJAX relay to info@rootrcm.com.
# Any replacement endpoint must preserve the public no-PHI boundary.
VITE_FORM_ENDPOINT=

# Appwrite migration: use owned mode with the deployed public Function URL.
# Only the Turnstile PUBLIC site key belongs here; secrets stay in Function settings.
VITE_CONTACT_MODE=legacy
VITE_TURNSTILE_SITE_KEY=

# --- Analytics, experiments, payments and search (all optional; every value is PUBLIC) ---------------
# Everything below is inlined into the public bundle. Secrets never use the VITE_ prefix: the build fails if a
# secret-shaped VITE_* variable is set (src/build/envGuard.js). Blank = feature disabled.

# production | preview | development. Production behaviour only applies on rootrcm.com / www.rootrcm.com.
VITE_SITE_ENV=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Blank keeps GA4 DISABLED. Loaded only after consent.
# Do not invent or guess an ID: copy it from GA4 > Admin > Data streams.
VITE_GA_MEASUREMENT_ID=

# Public HTTPS URL of the Appwrite `tracking-ingest` Function (functions/tracking-ingest). Blank keeps first-party
# analytics inert. Copy it from the Appwrite console; never guess it. Preview builds first.
VITE_TRACKING_ENDPOINT=

# A/B tests (docs/analytics/experiments.md). Production: off unless "true". Preview and local: on unless "false".
VITE_EXPERIMENTS_ENABLED=

# Optional PostHog (pre-existing, optional): project key and host. Inert when blank; loaded only after consent.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# Optional two-letter country code injected at the edge for coarse market defaults (pricing stays USD). Blank = US.
VITE_GEO_COUNTRY=

# Stripe, TEST MODE ONLY. The publishable key (pk_test_...) is the only Stripe value allowed in the browser.
# The build refuses any other key. Checkout sessions are created by a Function, never in the browser.
VITE_STRIPE_PUBLISHABLE_KEY=
# Public HTTPS URL of the checkout Function (functions/checkout). Blank keeps checkout hidden.
VITE_CHECKOUT_ENDPOINT=

# Optional scheduling link for /book/ (https only). Blank shows the inquiry form instead.
VITE_BOOKING_URL=

# Google Search Console HTML-tag verification token (the content value only). Blank omits the tag.
VITE_GSC_VERIFICATION=

# Server-side only (set in the Appwrite Function settings, NEVER here, never with a VITE_ prefix):
#   tracking-ingest: APPWRITE_PROJECT_ID, APPWRITE_DATABASE_ID, APPWRITE_TABLE_ID, APPWRITE_API_KEY,
#                    ALLOWED_ORIGINS, TRACKING_RETENTION_DAYS
#   checkout:        STRIPE_SECRET_KEY (sk_test_...), ALLOWED_ORIGINS
#   stripe-webhook:  STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET

# Future secure intake values stay blank until a BAA-backed service is approved.
VITE_SECURE_INTAKE_URL=
VITE_ANALYTICS_MEASUREMENT_ID=

# Build-time creative tooling only.
# Keep real keys in .env.local on your machine. Never prefix these with VITE_ because
# Vite exposes VITE_* values to client-side code.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional discovery-only provider. Unsplash API usage has hotlinking/download-tracking
# requirements, so it is intentionally not used by the local-download pipeline.
UNSPLASH_ACCESS_KEY=
